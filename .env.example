# =============================================================================
# .env.example — a template for environment variables
# =============================================================================
#
# THE PATTERN THIS FILE DEMONSTRATES
#
# Every real project needs configuration that differs per person and per
# environment: database passwords, API keys, which features are switched on.
# Those must never be hard-coded into your source files, and never committed.
#
# So teams use two files:
#
#   .env.example  <-- THIS FILE. Fake placeholder values. IS committed to Git.
#                     It documents WHICH variables the project needs.
#
#   .env          <-- Your real values. NEVER committed (see .gitignore).
#                     Lives only on your machine.
#
# WHY BOTH? Because a new teammate needs to know that an API key is required,
# without you having to send them the actual key over Slack. They copy this
# file, fill in their own values, and they're running.
#
#
# HOW TO USE IT
#
#   cp .env.example .env      (macOS/Linux)
#   copy .env.example .env    (Windows)
#
# Then open .env and replace every placeholder with a real value.
#
#
# SAFETY RULES
#
#   1. Never put a real secret in THIS file. It gets committed.
#   2. Never remove .env from .gitignore.
#   3. If you commit a secret by accident: change the secret immediately,
#      then ask for help cleaning the history. Don't just delete the file —
#      it stays in every previous commit, permanently.
#   4. When you add a new variable to your .env, add a placeholder here too,
#      or your teammates' setup will silently break.
#
#
# NOTE FOR THIS WORKSHOP
#
# This project is plain HTML and CSS — it has no server, so it never actually
# reads any of these values. They're here purely to show you the shape of a
# real .env file, because you'll meet this pattern in almost every repo.
#
#
# SYNTAX RULES
#
#   KEY=value          No spaces around the = sign
#   KEY="two words"    Quote values containing spaces
#   # comment          Lines starting with # are ignored
#
# Everything is text. There are no real "types" — but there are conventions
# for how to write numbers, booleans and lists, shown below.
# =============================================================================


# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# Where the app stores its data. In a real project these values differ between
# your laptop, the test server and production.

# STRING — the machine hosting the database.
# "localhost" means "this computer". In production it'd be a real hostname.
DB_HOST=localhost

# NUMBER — written without quotes. 5432 is the standard PostgreSQL port.
DB_PORT=5432

# STRING — which database to connect to on that host.
DB_NAME=nile_portfolio_dev

# STRING — the account used to log in.
DB_USER=workshop_user

# SECRET — replace with a real password in your .env, never here.
# Real projects use a long random string, not a memorable word.
DB_PASSWORD=replace_me_with_a_real_password

# URL — many tools accept the whole connection as a single string.
# Format: protocol://user:password@host:port/database
DATABASE_URL=postgresql://workshop_user:replace_me@localhost:5432/nile_portfolio_dev


# -----------------------------------------------------------------------------
# API KEYS AND TOKENS          *** THE MOST SENSITIVE SECTION ***
# -----------------------------------------------------------------------------
# These identify your app to other companies' services. Anyone holding one can
# act as you — spend your credits, read your data, send email as your domain.
#
# Where to get them: each service's dashboard, under Settings → API Keys.
# Rotate them (generate new, delete old) if one is ever exposed.

# STRING — general-purpose API key.
# Real ones usually carry a recognisable prefix, e.g. "sk_live_..." or "pk_test_...".
API_KEY=your_api_key_here

# SECRET — signs and verifies user login sessions.
# Must be long and random. Generate one with: openssl rand -hex 32
SECRET_TOKEN=your_secret_token_here

# TOKEN — a GitHub Personal Access Token, for scripts that call the GitHub API.
# Create at: GitHub → Settings → Developer settings → Personal access tokens
# Grant only the permissions actually needed. Set an expiry date.
GITHUB_TOKEN=ghp_your_personal_access_token_here

# TOKEN — email delivery service.
# A leaked email key means someone can send messages that look like they're
# from your company. Treat it as seriously as a password.
SENDGRID_API_KEY=SG.your_sendgrid_key_here


# -----------------------------------------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------------------------------------

# ENUM — one of a fixed set of options: development | test | production
# Frameworks read this to decide whether to show detailed error pages.
NODE_ENV=development

# URL — the app's own public address. Used when building links in emails.
# No trailing slash, by convention.
APP_URL=http://localhost:8000

# NUMBER — which port the local server listens on.
# Pick another (3000, 5000, 8080) if 8000 is already taken.
PORT=8000

# BOOLEAN — written as lowercase true / false, unquoted.
# Verbose logging: helpful locally, a security risk in production because
# error messages can reveal how the system works internally.
DEBUG=true


# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------
# Switches that turn parts of the app on and off without changing any code.
# Useful for releasing something to a few people first, or switching a broken
# feature off quickly without a deployment.

# BOOLEAN — allow comments on the site.
ENABLE_COMMENTS=true

# BOOLEAN — off by default here; analytics usually needs a privacy review first.
ENABLE_ANALYTICS=false

# BOOLEAN — show unfinished work-in-progress pages.
ENABLE_BETA_FEATURES=false


# -----------------------------------------------------------------------------
# ADVANCED FORMATS
# -----------------------------------------------------------------------------
# A few conventions you'll run into. All still just text.

# LIST — comma-separated, no spaces after the commas.
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000

# STRING WITH SPACES — must be quoted.
APP_NAME="Nile Demo Portfolio"

# NUMBER — durations are conventionally in seconds. 3600 = one hour.
SESSION_TIMEOUT=3600

# EMPTY — a variable that exists but has no value set.
OPTIONAL_SETTING=


# =============================================================================
# FURTHER READING
# =============================================================================
# The Twelve-Factor App, on configuration:  https://12factor.net/config
# GitHub's guide to keeping secrets safe:
#   https://docs.github.com/code-security/secret-scanning
# =============================================================================
